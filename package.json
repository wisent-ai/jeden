{
  "name": "@wisent-ai/jeden",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "jeden": "./bin/jeden-rust",
    "jeden-rust": "./bin/jeden-rust"
  },
  "scripts": {
    "check": "cargo check",
    "check:rust": "cargo check",
    "test:contracts": "node tests/contracts/task-contract-lifecycle.probierz.spec.mjs contracts",
    "test:context": "node tests/contracts/task-contract-lifecycle.probierz.spec.mjs context",
    "test:routing": "node tests/contracts/task-contract-lifecycle.probierz.spec.mjs routing",
    "test:model-stream": "cargo test --test model_stream",
    "test:tama-hooks": "cargo test --test tama_hooks",
    "build:rust": "cargo build --release && { if [ \"$(uname -s)\" != Darwin ]; then exit 0; fi; wisent-products signing sign --product jeden target/release/jeden target/release/jeden-sandbox-helper; }",
    "build:docs": "node web/docs/pages.mjs"
  },
  "dependencies": {
    "@wisent-ai/components": "file:vendor/wisent-components/9d202de39e14ff927af9641e0c0467e235176244/wisent-ai-components-0.8.1.tgz",
