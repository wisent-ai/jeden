{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jeden.dev/report/quality-report-v1.schema.json",
  "title": "Jeden canonical quality report payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "environment", "generated_at_epoch_seconds", "status", "evidence", "artifact_digests"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "generated_at_epoch_seconds": {"type": "integer", "minimum": 0},
    "status": {"enum": ["Passed", "Failed", "ExternalBlocked"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "status", "metrics", "environment", "revision", "evidence_uri", "evidence_digest", "source_envelope_digest", "prerequisites"],
        "properties": {
          "area": {"type": "string", "minLength": 1},
          "status": {"enum": ["Passed", "Failed", "ExternalBlocked"]},
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "numerator", "denominator"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "numerator": {"type": "integer", "minimum": 0},
                "denominator": {"type": "integer", "minimum": 1}
              }
            }
          },
          "environment": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "evidence_uri": {"type": "string", "pattern": "^artifact://[^\\s]+$"},
          "evidence_digest": {"$ref": "#/$defs/sha256"},
          "source_envelope_digest": {"$ref": "#/$defs/sha256"},
          "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "artifact_digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
