{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jeden.control-plane-e2e.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "endpointIdentities", "schemaRevisions", "requestIds", "evidenceDigest"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "status": {"enum": ["passed", "failed", "external-blocked"]},
    "endpointIdentities": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "schemaRevisions": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 2048}},
    "requestIds": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 2048}},
    "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "externalPrerequisites": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 2048}},
    "billingContractRevision": {"type": "string", "const": "weles-v2"},
    "redactedBillingRefs": {"type": "array", "maxItems": 512, "items": {"type": "string", "pattern": "^(opaque|sha256):[A-Za-z0-9._:-]+$"}}
  }
}
