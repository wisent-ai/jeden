{
  "schema_version": 1,
  "product": "jeden",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "secret_env": {
        "WISENT_CODESIGN_CERTIFICATE_PEM": "desktop-signing-apple-development#certificate",
        "WISENT_CODESIGN_PRIVATE_KEY_PEM": "desktop-signing-apple-development#private_key"
      },
      "quality": [
        {
          "name": "release-compile",
          "argv": ["python3", "release/cargo.py", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        }
      ],
      "build": {
        "argv": ["release/stado-build.sh", "--bin", "jeden", "--bin", "jeden-sandbox-helper"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "bin/jeden-sandbox-helper": "bin/jeden-sandbox-helper"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "release-compile",
          "argv": ["python3", "release/cargo.py", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        }
      ],
      "build": {
        "argv": ["release/stado-build.sh", "--bin", "jeden"]
      },
      "stage": {
        "bin/jeden": "bin/jeden"
      }
    }
  },
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/jeden/private-cargo-sources/eb4065b18419201737054544363c6f5f079ea358079a624e8af6c6f31d01d64c/private-cargo-sources.tar.gz",
      "sha256": "eb4065b18419201737054544363c6f5f079ea358079a624e8af6c6f31d01d64c",
      "mount": "private-cargo-sources",
      "extract": true
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  }
}
