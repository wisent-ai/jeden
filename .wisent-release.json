{
  "schema_version": 1,
  "product": "jeden",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "secret_env": {
        "WISENT_CODESIGN_CERTIFICATE_PEM": "desktop-signing-apple-development#certificate",
        "WISENT_CODESIGN_PRIVATE_KEY_PEM": "desktop-signing-apple-development#private_key"
      },
      "quality": [
        {
          "name": "inspection-framing",
          "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::conversation::action::tests"]
        },
        {
          "name": "native-image-read",
          "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::runtime::specs::image_read_tests"]
        },
        {
          "name": "release-compile",
          "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        },
        {
          "name": "native-stage",
          "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "cargo", "test", "--locked", "--release", "--target-dir", "target/qualification", "--test", "release", "--", "--ignored", "--exact", "stage_from_declared_input"]
        }
      ],
      "build": {
        "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "stage", "--bin", "jeden", "--bin", "jeden-sandbox-helper"]
      },
      "tests": [
        {
          "name": "pursuit-durable-refusals",
          "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "cargo", "test", "--locked", "--release", "--target-dir", "target/qualification", "--test", "pursuit", "--", "--ignored"]
        }
      ],
      "stage": {
        "bin/jeden": "bin/jeden",
        "bin/jeden-sandbox-helper": "bin/jeden-sandbox-helper",
        "release-tests": "evidence/release-tests",
        "pursuit-tests": "evidence/pursuit-tests"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "inspection-framing",
          "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::conversation::action::tests"]
