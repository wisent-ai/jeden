{
  "schema_version": 1,
  "product": "jeden",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "secret_env": {
        "WISENT_CODESIGN_CERTIFICATE_PEM": "macos-development-signing#certificate",
        "WISENT_CODESIGN_PRIVATE_KEY_PEM": "macos-development-signing#private_key"
      },
      "quality": [
        {"name": "fmt", "argv": ["cargo", "fmt", "--all", "--", "--check"]},
        {
          "name": "release-compile",
          "argv": ["stado", "product", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        },
        {
          "name": "native-stage",
          "argv": ["env", "JEDEN_TEST_SUCCESS_EXIT=0", "node", "tests/release/stage.mjs"]
        }
      ],
      "build": {
        "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "stage", "--bin", "jeden", "--bin", "jeden-sandbox-helper"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "bin/jeden-sandbox-helper": "bin/jeden-sandbox-helper",
        "release-tests": "evidence/release-tests"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {"name": "fmt", "argv": ["cargo", "fmt", "--all", "--", "--check"]},
        {
          "name": "release-compile",
          "argv": ["stado", "product", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        },
        {
          "name": "native-stage",
          "argv": ["env", "JEDEN_TEST_SUCCESS_EXIT=0", "node", "tests/release/stage.mjs"]
        }
      ],
      "build": {
        "argv": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "tools/Cargo.toml", "--", "release", "stage", "--bin", "jeden", "--bin", "jeden-sandbox-helper"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "bin/jeden-sandbox-helper": "bin/jeden-sandbox-helper",
        "release-tests": "evidence/release-tests"
      }
    },
    "web": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "web-quality",
          "argv": [
            "stado",
            "web",
            "quality",
            "--root",
            "web"
          ]
        }
      ],
      "build": {
        "argv": [
          "stado",
          "web",
          "build",
          "--root",
          "web"
        ]
      },
      "stage": {
        "dist/jeden-web.tar.gz": "jeden-web.tar.gz",
        "dist/jeden-web.tar.gz.sha256": "jeden-web.tar.gz.sha256",
        "dist/SOURCE_REVISION": "SOURCE_REVISION"
      },
      "secret_env": {}
    }
  },
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/jeden/private-cargo-sources/2032a0c8cc4dadfc9a71872dec6a3a0e5270fb8a9160b09889de0ec9acb668f2/private-cargo-sources.tar.gz",
      "sha256": "2032a0c8cc4dadfc9a71872dec6a3a0e5270fb8a9160b09889de0ec9acb668f2",
      "mount": "private-cargo-sources",
      "extract": true
    }
  },
  "deliveries": [
    {
      "name": "darwin-jeden",
      "platform": "darwin-arm64",
      "argv": ["stado", "release", "install-local", "--member", "bin/jeden", "--name", "jeden"],
      "required": true,
      "secret_env": {},
      "target": { "product": "jeden" }
    },
    {
      "name": "darwin-sandbox-helper",
      "platform": "darwin-arm64",
      "argv": ["stado", "release", "install-local", "--member", "bin/jeden-sandbox-helper", "--name", "jeden-sandbox-helper"],
      "required": true,
      "secret_env": {},
      "target": { "product": "jeden" }
    },
    {
      "name": "linux-jeden",
      "platform": "linux-amd64",
      "argv": ["stado", "release", "install-local", "--member", "bin/jeden", "--name", "jeden"],
      "required": true,
      "secret_env": {},
      "target": { "product": "jeden" }
    },
    {
      "name": "linux-sandbox-helper",
      "platform": "linux-amd64",
      "argv": ["stado", "release", "install-local", "--member", "bin/jeden-sandbox-helper", "--name", "jeden-sandbox-helper"],
      "required": true,
      "secret_env": {},
      "target": { "product": "jeden" }
    }
  ],
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  }
}
