{
  "schema_version": 1,
  "product": "jeden",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "secret_env": {
        "WISENT_CODESIGN_CERTIFICATE_PEM": "desktop-signing-apple-development#certificate",
        "WISENT_CODESIGN_PRIVATE_KEY_PEM": "desktop-signing-apple-development#private_key"
      },
      "quality": [
        {
          "name": "inspection-framing",
          "argv": ["python3", "release/cargo.py", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::conversation::action::tests"]
        },
        {
          "name": "native-image-read",
          "argv": ["python3", "release/cargo.py", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::runtime::specs::image_read_tests"]
        },
        {
          "name": "release-compile",
          "argv": ["python3", "release/cargo.py", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        },
        {
          "name": "native-stage",
          "argv": ["python3", "tests/release/private-sources.py", "--stage"]
        }
      ],
      "build": {
        "argv": ["python3", "release/cargo.py", "stage", "--bin", "jeden", "--bin", "jeden-sandbox-helper"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "bin/jeden-sandbox-helper": "bin/jeden-sandbox-helper",
        "release-tests": "evidence/release-tests"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "inspection-framing",
          "argv": ["python3", "release/cargo.py", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::conversation::action::tests"]
        },
        {
          "name": "native-image-read",
          "argv": ["python3", "release/cargo.py", "cargo", "test", "--locked", "--release", "--bin", "jeden", "agent::runtime::specs::image_read_tests"]
        },
        {
          "name": "release-compile",
          "argv": ["python3", "release/cargo.py", "cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        },
        {
          "name": "native-stage",
          "argv": ["python3", "tests/release/private-sources.py", "--stage"]
        }
      ],
      "build": {
        "argv": ["python3", "release/cargo.py", "stage", "--bin", "jeden"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "release-tests": "evidence/release-tests"
      }
    }
  },
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/jeden/private-cargo-sources/16aabde6fde60e9f2efce83a7e65ad1ee30b5be0ee8c03739da2cc299519ae71/private-cargo-sources.tar.gz",
      "sha256": "16aabde6fde60e9f2efce83a7e65ad1ee30b5be0ee8c03739da2cc299519ae71",
      "mount": "private-cargo-sources",
      "extract": true
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  }
}
