{
  "schema_version": 1,
  "product": "jeden",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "release-compile",
          "argv": ["cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        }
      ],
      "build": {
        "argv": ["release/stado-build.sh", "--bin", "jeden", "--bin", "jeden-sandbox-helper"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "bin/jeden-sandbox-helper": "bin/jeden-sandbox-helper",
        "evidence/DIGESTS": "evidence/DIGESTS"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "release-compile",
          "argv": ["cargo", "build", "--locked", "--release", "--bin", "jeden-quality-report"]
        }
      ],
      "build": {
        "argv": ["release/stado-build.sh", "--bin", "jeden"]
      },
      "stage": {
        "bin/jeden": "bin/jeden",
        "evidence/DIGESTS": "evidence/DIGESTS"
      }
    }
  },
  "runtime": {
    "binary": "bin/jeden",
    "launcher": "bin/jeden",
    "config_schema": 4,
    "state_schema": 2,
    "minimum_stado_version": "0.6.1",
    "rollback_compatible_with": []
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": true
  }
}
