{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jeden.dev/release/release-envelope-v2.schema.json",
  "title": "ReleaseManifestV2 DSSE Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": { "const": "application/vnd.jeden.release-manifest.v2+json" },
    "payload": { "type": "string", "contentEncoding": "base64", "minLength": 4 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
          "sig": { "type": "string", "contentEncoding": "base64", "minLength": 88, "maxLength": 88 }
        }
      }
    }
  }
}
