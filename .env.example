# Required: provider-neutral Brama model-router URL.
BRAMA_URL=
# Optional bearer for Brama; never reuse STADO_API_TOKEN.
BRAMA_TOKEN=
WISENT_APP_AGENT_ID=wisent-app
WISENT_APP_AGENT_AUTH_SECRET=
# Optional managed organization and billing service. Local Jeden works without them.
WISENT_ORGANIZATION_ID=
WISENT_PLATFORM_BILLING_URL=
WISENT_PLATFORM_BILLING_TOKEN=
# Legacy aliases remain readable during migration: WELES_URL, WELES_TOKEN.
# Required for image generation/editing and TTS; the scoped bearer is injected by scripts/run-with-stado.sh.
STADO_MEDIA_ROUTER_URL=
JEDEN_MEDIA_ROUTER_TOKEN=
STADO_MEDIA_ROUTER_ALLOW_INSECURE_LOOPBACK=
JEDEN_IMAGE_MODEL=
JEDEN_TTS_MODEL=
# Optional onboarding telemetry. Without them the first-use journey runs from the
# definition compiled into the binary; with them it reads the published bundle and
# reports funnel events. The scoped bearer is injected by scripts/run-with-stado.sh
# from the Skarbiec item jeden-integration-api, which needs the onboarding/jeden.*
# grants (bundle.read, experiments.assign, events.collect, state.read).
STADO_INTEGRATION_API_URL=
JEDEN_STADO_INTEGRATION_TOKEN=
# ENTITLEMENTS_ROUTER_BIN=/absolute/path/to/entitlements-router
JEDEN_MODEL=claude-code-subscription
