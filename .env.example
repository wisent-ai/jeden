# Select one model route. An explicit direct provider needs no Brama credentials.
JEDEN_MODEL_ENDPOINT=
# Optional process key; when absent, `jeden token add` can supply an endpoint-scoped key.
JEDEN_MODEL_KEY=
# Brama route: export its address or let Stado's service directory locate it.
BRAMA_URL=
BRAMA_TOKEN=
WISENT_APP_AGENT_ID=
WISENT_APP_AGENT_AUTH_SECRET=
# Choose a model advertised by the selected provider or Brama route.
JEDEN_MODEL=
# Durable memory, pursuit state and relay rooms require a direct database URL.
JEDEN_DATABASE_URL=
# Server databases also require a certificate-authority file.
JEDEN_DATABASE_CA_FILE=
# Optional managed organization and billing service. Local Jeden works without them.
WISENT_ORGANIZATION_ID=
WISENT_PLATFORM_BILLING_URL=
WISENT_PLATFORM_BILLING_TOKEN=
# Image generation and TTS go through Brama (BRAMA_URL); these override the
# deployment's image-model and voice-model aliases.
JEDEN_IMAGE_MODEL=
JEDEN_TTS_MODEL=
# Optional onboarding telemetry. Without these variables the first-use journey
# runs from the definition compiled into the binary. With both, it reads the
# published bundle and reports funnel events using the caller's process token.
STADO_INTEGRATION_API_URL=
JEDEN_STADO_INTEGRATION_TOKEN=
# ENTITLEMENTS_ROUTER_BIN=/absolute/path/to/entitlements-router
