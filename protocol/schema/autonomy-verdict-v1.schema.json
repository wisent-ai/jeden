{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisent.ai/jeden/schema/autonomy-verdict-v1.schema.json",
  "title": "Jeden autonomous task verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decision",
    "summary",
    "criteria",
    "contradictions",
    "requiredRepairs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "type": "string", "enum": ["accept", "revise"] },
    "summary": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "evidence", "gap"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "passed": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "gap": { "type": "string" }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredRepairs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
