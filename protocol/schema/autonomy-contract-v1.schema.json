{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisent.ai/jeden/schema/autonomy-contract-v1.schema.json",
  "title": "Jeden autonomous task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "roughObjective",
    "intendedUser",
    "intendedOutcome",
    "startingState",
    "sourcesOfTruth",
    "constraints",
    "nonGoals",
    "acceptanceCriteria",
    "rejectionConditions",
    "requiredEvidence",
    "implementationPlan"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 3 },
    "roughObjective": { "type": "string", "minLength": 1 },
    "intendedUser": { "type": "string", "minLength": 1 },
    "intendedOutcome": { "type": "string", "minLength": 1 },
    "startingState": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceFact" }
    },
    "sourcesOfTruth": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceFact" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nonGoals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "rejectionConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRequirement" }
    },
    "implementationPlan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "evidenceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fact"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "fact": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "observation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "outcome": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "kind", "observation"],
      "properties": {
        "criterionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": {
          "type": "string",
          "enum": ["source", "configuration", "manifest", "history", "product-output", "artifact"]
        },
        "observation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
