{
  "name": "@jeden/session-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/example"
  ],
  "scripts": {
    "generate:protocol": "node scripts/protocol-keys.mjs",
    "build": "npm run generate:protocol && tsc -p tsconfig.json",
    "typecheck": "npm run generate:protocol && tsc -p tsconfig.json --noEmit",
    "test": "node ../../tests/protocol/envelope-keys.mjs",
    "example": "npm run build && node dist/example/session_client.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
