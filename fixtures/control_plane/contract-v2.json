{
  "schemaVersion": 2,
  "fixtureId": "control-plane-billing-contract-v2",
  "transport": "injected",
  "service": "weles",
  "services": ["brama", "weles"],
  "apiPrefix": "/v2",
  "security": {
    "paymentAuthority": "weles",
    "hostedSetupOnly": true,
    "rawPaymentDetailsAccepted": false,
    "responseBodiesSuppressedOnError": true,
    "financialMutationIdempotency": "caller-stable-required"
  },
  "welesBilling": {
    "api": "WelesApiV2",
    "basePath": "/v2",
    "paymentDataAuthority": "weles",
    "opaqueTypes": ["PaymentMethodReference", "BillingGrant"],
    "hostedSetup": {
      "httpsRequired": true,
      "originAllowlistRequired": true
    },
    "financialMutationRequirements": [
      "caller-stable-correlation-id",
      "caller-stable-idempotency-key",
      "policy-revision",
      "quote-revision"
    ],
    "forbiddenRequestFields": [
      "pan",
      "cardNumber",
      "cvv",
      "cvc",
      "processorToken",
      "rawPaymentDetails",
      "billingAddress",
      "shippingAddress",
      "fullAddress",
      "cardholder",
      "expiry",
      "expiration"
    ],
    "sideEffectFree": ["billing-status", "payment-method-list", "purchase-policy-read", "subscription-list", "quota-read", "quote"],
    "mutations": ["hosted-setup", "payment-method-revoke", "policy-set", "policy-disable", "purchase", "renew", "cancel"]
  },
  "bramaAttribution": {
    "selectedRoute": true,
    "servedRoute": "authoritative",
    "billingSnapshot": ["providerId", "accountId", "subscriptionId", "quota"]
  },
  "cases": [
    "v2-schema-negotiation",
    "encoded-path-segments",
    "bounded-lists",
    "forbidden-payment-field-rejection",
    "redacted-opaque-debug",
    "https-hosted-setup",
    "hosted-origin-denial",
    "quote-without-idempotency",
    "mutation-without-idempotency-denial",
    "policy-default-disabled",
    "policy-revision-pinning",
    "quote-revision-pinning",
    "typed-quota",
    "selected-versus-served-attribution",
    "response-body-suppression",
    "payment-method-setup-hosted-https-allowlist",
    "payment-method-setup-rejects-http",
    "payment-method-setup-rejects-non-allowlisted-origin",
    "payment-method-list-bounded",
    "payment-method-reference-redacted-debug",
    "payment-method-reference-wire-roundtrip",
    "payment-method-revoke-idempotent",
    "purchase-policy-default-disabled",
    "purchase-policy-stale-revision",
    "purchase-policy-single-cap-boundary",
    "purchase-policy-single-cap-exceeded",
    "purchase-policy-period-cap-boundary",
    "purchase-policy-period-cap-exceeded",
    "purchase-policy-arithmetic-overflow",
    "purchase-policy-product-denied",
    "purchase-policy-currency-denied",
    "purchase-policy-expired",
    "subscription-list-bounded",
    "subscription-account-attribution",
    "quota-subscription-attribution",
    "quota-remaining-never-exceeds-limit",
    "quote-expired",
    "quote-account-attribution",
    "quote-provider-attribution",
    "quote-product-attribution",
    "quote-currency-attribution",
    "purchase-replay-same-key-same-body",
    "purchase-conflict-same-key-different-body",
    "renew-concurrent-single-charge",
    "cancel-complete-race-idempotent",
    "typed-401",
    "typed-403",
    "typed-404",
    "typed-409",
    "typed-422",
    "typed-428",
    "typed-429-retry-after",
