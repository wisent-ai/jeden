#!/usr/bin/env sh
set -eu
PRG="$0"
while [ -L "$PRG" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)"
  LINK="$(readlink "$PRG")"
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$DIR/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname -- "$PRG")/.." && pwd)"
MANIFEST="$ROOT/Cargo.toml"
BIN="$ROOT/target/release/jeden"
STADO_BOOTSTRAP="$ROOT/scripts/run-with-stado.sh"

needs_model_runtime() {
  case "${1:-}" in
    ""|run|rpc|headless|acp|resume|recall_conversation|recall-conversation|token|probierz) return 0 ;;
    *) return 1 ;;
  esac
}

run_jeden() {
  if needs_model_runtime "${1:-}" \
    && { [ -z "${BRAMA_URL:-}" ] || [ -z "${WISENT_APP_AGENT_AUTH_SECRET:-}" ]; } \
    && [ "${JEDEN_STADO_BOOTSTRAPPED:-0}" != 1 ] \
    && [ -f "$STADO_BOOTSTRAP" ] \
    && [ -f "${JEDEN_SKARBIEC_TOKEN_FILE:-$HOME/.stado/local-operator-skarbiec-token}" ]; then
    JEDEN_BIN="$BIN" JEDEN_STADO_BOOTSTRAPPED=1 \
      exec /usr/bin/env bash "$STADO_BOOTSTRAP" "$@"
  fi
  exec "$BIN" "$@"
}


if [ -f "$MANIFEST" ]; then
  cargo build --quiet --manifest-path "$MANIFEST" --release \
    --bin jeden --bin jeden-sandbox-helper
elif [ ! -x "$BIN" ]; then
  printf '%s\n' "jeden: packaged executable not found: $BIN" >&2
  exit 127
fi
run_jeden "$@"
