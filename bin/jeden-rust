#!/usr/bin/env sh
set -eu
PRG="$0"
while [ -L "$PRG" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)"
  LINK="$(readlink "$PRG")"
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$DIR/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname -- "$PRG")/.." && pwd)"
MANIFEST="$ROOT/Cargo.toml"
BIN="$ROOT/target/release/jeden"

# The binary resolves its own credential: on the first control-plane read it
# asks Stado for `agent:wisent-app/value` and `jeden-model-router/token` when
# the environment does not carry them. This launcher used to exec
# `scripts/run-with-stado.sh` for that, and the scripts purge on 2026-09-06
# deleted the file while leaving the exec behind, so a configured workstation
# fell straight through to `BRAMA_URL is required`.
run_jeden() {
    exec "$BIN" "$@"
}

if [ -f "$MANIFEST" ]; then
  cargo build --quiet --manifest-path "$MANIFEST" --release \
    --bin jeden --bin jeden-sandbox-helper
elif [ ! -x "$BIN" ]; then
  printf '%s\n' "jeden: packaged executable not found: $BIN" >&2
  exit 127
fi
run_jeden "$@"
