#!/usr/bin/env sh
set -eu
PRG="$0"
while [ -L "$PRG" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)"
  LINK="$(readlink "$PRG")"
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$DIR/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname -- "$PRG")/.." && pwd)"
BIN="$ROOT/target/release/jeden"
if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi
exec cargo run --quiet --manifest-path "$ROOT/Cargo.toml" -- "$@"
